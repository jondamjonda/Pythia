# Production secrets template — copy to /etc/regsuper/secrets.env on the VPS
# and `chmod 600`. NEVER commit a populated copy.
#
# All `<placeholder>` values must be filled before `systemctl start regsuper-api`.

# -----------------------------------------------------------------------------
# Database — running locally on the same VPS via docker-compose
# -----------------------------------------------------------------------------
# POSTGRES_PASSWORD seeds the Postgres container (docker-compose.prod.yml reads
# ${POSTGRES_PASSWORD}) AND must match the <db-password> in the two DSNs below.
# Pick one strong value and use it in all three places. (LEDGER-M27: install.sh
# falls back to "regsuper" only when this is unset — never rely on that fallback
# in prod.)
POSTGRES_PASSWORD=<db-password>
DATABASE_URL=postgresql+asyncpg://regsuper:<db-password>@127.0.0.1:5432/regsuper
DATABASE_URL_SYNC=postgresql://regsuper:<db-password>@127.0.0.1:5432/regsuper

# -----------------------------------------------------------------------------
# LLM providers
# -----------------------------------------------------------------------------
OPENAI_API_KEY=<sk-...>
ANTHROPIC_API_KEY=
COHERE_API_KEY=<rerank-trial-or-prod-key>

# -----------------------------------------------------------------------------
# Hetzner Object Storage (Frankfurt FSN1) — plan §15
# Create the bucket at https://console.hetzner.com/projects → Object Storage.
# Endpoint URL format: https://<region>.your-objectstorage.com
# -----------------------------------------------------------------------------
S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
S3_ACCESS_KEY=<bucket-access-key>
S3_SECRET_KEY=<bucket-secret-key>
S3_BUCKET=regsuper-mvp
S3_REGION=fsn1

# -----------------------------------------------------------------------------
# Server / paths
# -----------------------------------------------------------------------------
LOG_DIR=/var/log/regsuper
DATA_DIR=/var/lib/regsuper/data
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Admin dashboard basic-auth — change these immediately.
# -----------------------------------------------------------------------------
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASS=<change-me-long-random-string>

# -----------------------------------------------------------------------------
# Calibrated refusal threshold (Day-13 hardcodes this after lawyer labeling).
# Placeholder 0.6 used before calibration completes.
# -----------------------------------------------------------------------------
REFUSAL_THRESHOLD=0.6

# -----------------------------------------------------------------------------
# Frontend → API CORS — comma-separated list of allowed origins.
# Add the production Vercel URL once the frontend is deployed.
# -----------------------------------------------------------------------------
FRONTEND_ORIGINS=https://app.your-domain.example,https://your-vercel-preview.vercel.app

# -----------------------------------------------------------------------------
# Deployment posture (LEDGER-H14 / LEDGER-H7).
# -----------------------------------------------------------------------------
# ENVIRONMENT controls the boot guards and the control-token gate. It defaults to
# "local" in code, which is OPEN. A prod box that forgets this line boots as
# environment=local → the anonymous-serving boot guard never fires and the
# control-token gate defaults open. ALWAYS set this to "prod" (or "staging").
ENVIRONMENT=prod

# REQUIRE_AUTH — make a DELIBERATE decision here; do not leave it implicit.
#   REQUIRE_AUTH=false : anonymous serving (everything maps to the sentinel org).
#                        With ENVIRONMENT=prod the boot guard will REFUSE to start
#                        unless this is an explicit, intended choice.
#   REQUIRE_AUTH=true  : fail-closed auth. DO NOT flip to true until auth-readiness
#                        is verified — the product read routes do not yet fail closed
#                        under it and principal resolution is coupled to tenancy, not
#                        require_auth (see LEDGER-H2). Flipping it prematurely serves
#                        product read routes with no session validation.
REQUIRE_AUTH=false
