# Copy to secrets.env and fill in. NEVER commit secrets.env.

# Database — local Docker default
DATABASE_URL=postgresql+asyncpg://regsuper:regsuper@localhost:5432/regsuper
DATABASE_URL_SYNC=postgresql://regsuper:regsuper@localhost:5432/regsuper

# Hetzner deployment (filled in on Day 0 — leave empty for local dev)
HETZNER_HOST=
HETZNER_USER=root
HETZNER_SSH_KEY=

# LLM and embedding APIs
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
COHERE_API_KEY=

# Object storage (Hetzner Object Storage / R2 / S3-compatible)
S3_ENDPOINT_URL=https://fsn1.your-objectstorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=regsuper-mvp
S3_REGION=fsn1

# App config
LOG_DIR=./logs
LOG_LEVEL=INFO
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASS=changeme

# Refusal threshold — placeholder until calibration (Day 13)
REFUSAL_THRESHOLD=0.6

# Models
ANALYSIS_MODEL=claude-sonnet-4-6
CHEAP_MODEL=claude-haiku-4-5-20251001
EMBEDDING_MODEL=text-embedding-3-large
RERANK_MODEL=rerank-v3.5

# Pythia reasoning sidecar (P7) — feature-flagged, default OFF.
# Leave PYTHIA_ENABLED=false (or unset) to keep the app exactly as today. To use the local Pythia
# engine, run the sidecar (uvicorn pythia.service:app --port 9000 from engine/) and set:
PYTHIA_ENABLED=false
PYTHIA_URL=
