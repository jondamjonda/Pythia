{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "regions": ["fra1"],
  "env": {
    "NEXT_PUBLIC_API_URL": "@regsuper_api_url",
    "BACKEND_URL": "@regsuper_backend_url",
    "CONTROL_PANEL_TOKEN": "@regsuper_control_panel_token",
    "ENVIRONMENT": "@regsuper_environment"
  }
}
